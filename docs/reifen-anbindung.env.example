# Nur Vorlage. Echte Werte ausschließlich in der privaten Serverkonfiguration.
# Nicht als .env mit Zugangsdaten ins Repository übernehmen.
REIFEN_KAUF_MODE=off
REIFEN_KAUF_ENABLED=0
REIFEN_KAUF_WORKER_ENABLED=0

# Separater TYREsystem-API-Testzugang, kein Shop-Login. Noch kein Such-/Kaufadapter.
# Die Modusangabe ist lokal; RSU muss den tatsächlichen Servermodus bestätigen.
TYRESYSTEM_API_USERNAME=
TYRESYSTEM_API_PASSWORD=
TYRESYSTEM_API_MODE=test

# Eigener Reifen-Zugang. Keine automatische Übernahme von MOS-Mietwagen-Keys.
REIFEN_STRIPE_SECRET_KEY=
REIFEN_STRIPE_WEBHOOK_SECRET=
REIFEN_STRIPE_PUBLIC_ORIGIN=
REIFEN_STRIPE_ALLOWED_REDIRECT_HOSTS=
# Webhook auf dem zentralen Portal: /webhooks/reifen/stripe

REIFEN_TWILIO_ACCOUNT_SID=
REIFEN_TWILIO_VERIFY_SERVICE_SID=
# Genau ein Authweg. Empfohlen: Restricted SK-Key mit nur
# twilio/verify/verification/create und twilio/verify/verification-check/create.
REIFEN_TWILIO_API_KEY_SID=
REIFEN_TWILIO_API_KEY_SECRET=
# Alternative fuer bestehenden Testzugang: Token setzen, beide Key-Felder leer.
REIFEN_TWILIO_AUTH_TOKEN=
REIFEN_SMS_KOSTEN_FREIGEGEBEN=0
REIFEN_SMS_MAX_STARTS_PRO_TAG=0
# In Testumgebung nur diese ausdrücklich freigegebenen E.164-Nummern:
REIFEN_SMS_TESTNUMMERN=

REIFEN_KAUF_MAIL_ENABLED=0
REIFEN_SMTP_HOST=
REIFEN_SMTP_PORT=465
REIFEN_SMTP_TLS_MODE=ssl
REIFEN_SMTP_USER=
REIFEN_SMTP_PASSWORD=
REIFEN_SMTP_FROM=info@auto-lackierzentrum.de
REIFEN_MAIL_TESTEMPFAENGER=

# Freigegebene finale JSON-Fassung samt korrektem SHA, keine Entwurfsversion.
REIFEN_TERMS_FILE=
REIFEN_TERMS_APPROVED_SHA256=
