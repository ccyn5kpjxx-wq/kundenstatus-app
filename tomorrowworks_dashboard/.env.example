# Öffentliche HTTPS-Adresse, sobald das Kundenportal bereit für externe Kunden ist
TW_PUBLIC_BASE_URL=

# Bei gemeinsamer Render-Bereitstellung laeuft das Cockpit unter diesem Pfad
TW_APPLICATION_ROOT=/agentur
TW_SESSION_COOKIE_SECURE=1
TW_DASHBOARD_DATA_DIR=/var/data/tomorrowworks_dashboard
TW_DASHBOARD_DB_PATH=/var/data/tomorrowworks_dashboard/dashboard.db
TW_DASHBOARD_UPLOAD_DIR=/var/data/tomorrowworks_dashboard/uploads
TW_DASHBOARD_SECRET_KEY=
TW_GIT_MONITOR=0
TW_SQLITE_BUSY_TIMEOUT_MS=30000

# SMTP für Kunden- und Team-Benachrichtigungen
TW_SMTP_HOST=
TW_SMTP_PORT=587
TW_SMTP_USER=
TW_SMTP_PASSWORD=
TW_SMTP_FROM=Tomorrow Works <info@tomorrowworks-agentur.de>
TW_SMTP_TLS=1
TW_SMTP_SSL=0
TW_TEAM_NOTIFY_EMAIL=info@tomorrowworks-agentur.de

# Erst nach juristischer Freigabe der konkreten Vertrags- und Datenschutztexte aktivieren
TW_CONTRACT_LEGAL_APPROVED=0
TW_CONTRACT_PROVIDER_NAME=Gärtner GmbH Karosserie + Lack - Geschäftsbereich Tomorrow Works
TW_CONTRACT_PROVIDER_ADDRESS=Binauer Höhe 4, 74821 Mosbach
TW_CONTRACT_PROVIDER_REPRESENTATIVE=Geschäftsführer: Christopher Gärtner
TW_CONTRACT_PROVIDER_EMAIL=info@tomorrowworks-agentur.de

# Optionale Laufzeitkonfiguration
TW_DASHBOARD_HOST=0.0.0.0
TW_DASHBOARD_PORT=5070
TW_GIT_MONITOR_INTERVAL=30
